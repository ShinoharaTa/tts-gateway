# tts-gateway の環境変数の例。systemd では ~/.config/tts-gateway/env に置く（リポジトリに入れない）。
# 値はすべて例。アドレスはドキュメント用（RFC 5737 / 3849）のものなので、自分の環境の値に置き換える。

# 待ち受けるアドレス（カンマ区切り、各アドレスに listen）。IP アドレスだけ。0.0.0.0・:: は起動時エラー
# ループバック以外を入れるなら TTS_TOKEN か TTS_ADMIN_TOKEN が必須
TTS_HOSTS=127.0.0.1,192.0.2.10
TTS_PORT=8710

# Host ヘッダに許すホスト名（ポートは問わない）。TTS_HOSTS のアドレスと localhost は書かなくてよい
# 名前でアクセスする・リバースプロキシの後ろに置くときに、その名前を入れる
# TTS_ALLOWED_HOSTS=tts.example.com,myhost.tailnet.example

# 待ち受けアドレスごとの同時接続の上限（1〜1024）
# TTS_MAX_CONNECTIONS=64

# 接続を許す範囲（IPv4-mapped IPv6 は IPv4 として判定）
TTS_ALLOW_CIDRS=127.0.0.1/32,::1/128,192.0.2.0/24

# 設定したときだけ認証が必須になる（/v1/admin/* は TTS_ADMIN_TOKEN があればその値。TTS_ADMIN_TOKEN は通常の API にも使える）
# change-me で始まる値のままだと起動しない。openssl rand -hex 32 などで作る（16 文字未満は警告）
TTS_TOKEN=change-me-api-token
TTS_ADMIN_TOKEN=change-me-admin-token

# 1 にすると、ループバック以外で待ち受けていてもトークン無しで起動する（警告を出す）
# TTS_ALLOW_NO_TOKEN=1

# データ（settings.json・models.json・重み・ユーザー辞書）とキャッシュ。省略時は XDG の既定
# TTS_DATA_DIR=/srv/tts-gateway/data
# TTS_CACHE_DIR=/srv/tts-gateway/cache

# 合成の同時実行数（1〜2）・待ち行列の上限・text の上限・タイムアウト（秒）
TTS_CONCURRENCY=1
TTS_QUEUE_MAX=8
# TTS_CONCURRENCY=2 のとき、同じ声の要求に追い越された要求が待つ上限（ミリ秒、0〜60000。最初に追い越されてから数える）
# TTS_AFFINITY_MAX_WAIT_MS=5000
TTS_MAX_CHARS=2000
TTS_TIMEOUT_SEC=60

# モデルを取得してよいホスト（サブドメインも可）と上限（MB）・1 件のダウンロードの上限（秒、10〜86400）
TTS_MODEL_HOSTS=tts-models.zenryoku.work,huggingface.co,hf.co
TTS_MODEL_MAX_MB=512
TTS_MODEL_TIMEOUT_SEC=600

# ffmpeg のパス（PATH にあれば不要）
# FFMPEG=/usr/local/bin/ffmpeg
